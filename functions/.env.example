# Copy to functions/.env.dev and functions/.env.prod (one per Firebase project alias).
# Firebase loads functions/.env.<alias> automatically when you deploy with --project <alias>.
# These files are git-ignored. Never put API secrets here – use `firebase functions:secrets:set`.

# Comma-separated emails allowed to create a shop. Leave empty to allow anyone (fine for dev, NOT for prod).
OWNER_EMAILS=
